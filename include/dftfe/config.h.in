// config.h — generated by CMake from config.h.in at build time.
// Do NOT edit config.h directly; edit include/dftfe/config.h.in instead.
#ifndef DFTFE_CONFIG_H
#define DFTFE_CONFIG_H

/* DFT-FE version string */
#cmakedefine DFTFE_VERSION "@DFTFE_VERSION@"

/* Use complex or real arithmetic (exactly one will be defined) */
#cmakedefine USE_COMPLEX
#cmakedefine USE_REAL

/* PETSc/SLEPc support (derived from deal.II configuration) */
#cmakedefine USE_PETSC

/* Higher-order quadrature for PSP */
#cmakedefine DFTFE_WITH_HIGHERQUAD_PSP

/* 64-bit integer indices */
#cmakedefine DFTFE_WITH_64BIT_INT

/* GPU support */
#cmakedefine DFTFE_WITH_DEVICE
#cmakedefine DFTFE_WITH_DEVICE_NVIDIA
#cmakedefine DFTFE_WITH_DEVICE_AMD
#cmakedefine DFTFE_WITH_DEVICE_INTEL
#cmakedefine DFTFE_WITH_DEVICE_MKL
#cmakedefine DFTFE_WITH_DEVICE_LANG_CUDA
#cmakedefine DFTFE_WITH_DEVICE_LANG_HIP
#cmakedefine DFTFE_WITH_DEVICE_LANG_SYCL
#cmakedefine DFTFE_WITH_DEVICE_AWARE_MPI
#cmakedefine DFTFE_WITH_CUDA_NCCL
#cmakedefine DFTFE_WITH_HIP_RCCL

/* Optional: customised deal.II build */
#cmakedefine DFTFE_WITH_CUSTOMIZED_DEALII

/* Optional: dispersion corrections */
#cmakedefine DFTFE_WITH_DFTD3
#cmakedefine DFTFE_WITH_DFTD4

/* Optional: LibTorch neural-network potentials */
#cmakedefine DFTFE_WITH_TORCH

/* Optional: MDI protocol */
#cmakedefine DFTFE_WITH_MDI

/* Disable runtime assertions */
#cmakedefine DFTFE_DISABLE_ASSERT

#endif /* DFTFE_CONFIG_H */
