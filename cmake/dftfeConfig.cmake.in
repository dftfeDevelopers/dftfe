# cmake/dftfeConfig.cmake.in
#
# CMake package configuration file for DFT-FE.
# Processed by configure_package_config_file() → installed as dftfeConfig.cmake
# at <prefix>/lib/cmake/dftfe/.
#
# Downstream usage — example CMakeLists.txt:
#
#   cmake_minimum_required(VERSION 3.17)
#   project(myapp LANGUAGES CXX)
#
#   find_package(dftfe REQUIRED HINTS /opt/dftfe/lib/cmake/dftfe)
#
#   add_executable(myapp main.cpp)
#   target_link_libraries(myapp PRIVATE dftfe::dftfeReal)
#   # use dftfe::dftfeComplex if DFT-FE was built with -DWITH_COMPLEX=ON
#
# Linking against the imported target automatically adds <prefix>/include to
# the consumer's include path and transitively links deal.II, ELPA, and MPI.
#
# Feature flags (USE_REAL, DFTFE_WITH_DEVICE, etc.) are NOT injected as -D
# compiler flags. config.h is generated and installed by dftfeGenerateConfig()
# in cmake/dftfeGenerateConfig.cmake; the consumer reads flags from it:
#
#   // main.cpp
#   #include <dftfe/config.h>       // USE_REAL, DFTFE_WITH_DEVICE, ...
#   #include <dftfe/dftfeWrapper.h>
#
#   #ifdef DFTFE_WITH_DEVICE
#     // GPU-aware code path
#   #endif

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Append our install directory so bundled Find*.cmake modules (FindELPA.cmake
# etc.) are available when re-resolving dependencies for the consumer.
list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")

# ── Public dependencies ───────────────────────────────────────────────────────
# These are linked PUBLIC in DFT-FE, so consumers of dftfe::dftfeReal also
# need them on their include path and link line.

# deal.II — its types appear directly in dftfe public headers
find_dependency(deal.II 9.5.1)

# ELPA — linked PUBLIC
find_dependency(ELPA 2023)

# MPI — linked PUBLIC
find_dependency(MPI REQUIRED)

# ── Exported target definitions ───────────────────────────────────────────────
# dftfeTargets.cmake was generated by install(EXPORT dftfeTargets ...) and
# defines the dftfe::dftfeReal / dftfe::dftfeComplex imported targets with
# correct INTERFACE_INCLUDE_DIRECTORIES. Feature flags are not listed under
# INTERFACE_COMPILE_DEFINITIONS; they are encoded in the installed config.h.
include("${CMAKE_CURRENT_LIST_DIR}/dftfeTargets.cmake")

check_required_components(dftfe)
